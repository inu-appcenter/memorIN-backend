# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=memorin_db
POSTGRES_USER=memorin_user
POSTGRES_PASSWORD=memorin_pass
POSTGRES_PORT=5432

# ─── MinIO ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=memorin-media
MINIO_REGION=us-east-1
# 클라이언트(브라우저/앱)가 presigned URL로 직접 접근할 주소. 로컬이 아닌 환경(스테이징/운영)에서는
# 반드시 실제로 접근 가능한 도메인으로 바꿔야 한다 — localhost로 두면 서버 밖에서는 업로드/다운로드가 전부 깨진다.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# presigned URL 유효기간(초)
MINIO_PRESIGNED_UPLOAD_EXPIRY_SECONDS=600
MINIO_PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=300
# 업로드 허용 MIME 타입 (콤마 구분)
MINIO_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime
# 파일 1개 업로드 최대 크기(byte). 기본 50MB
MINIO_MAX_UPLOAD_SIZE_BYTES=52428800

# ─── Spring Boot ──────────────────────────────────────────────
BACKEND_PORT=8080
# 백엔드 컨테이너 메모리 상한. JVM 힙은 이 값의 75%로 잡힌다(JAVA_TOOL_OPTIONS).
# 채팅(WebSocket) 세션이 힙에 쌓이는 구조라 상한 없이 띄우면 환경마다 다르게 동작한다.
BACKEND_MEMORY_LIMIT=1g

# ─── Storage Quota ────────────────────────────────────────────
# 유저별 총 스토리지 할당량(byte). 기본 1GB
STORAGE_QUOTA_DEFAULT_LIMIT_BYTES=1073741824
# presigned 업로드 예약(pending_uploads)의 TTL(초). 커밋 없이 만료되면 정리 배치가 회수
STORAGE_QUOTA_PENDING_TTL_SECONDS=900
# 할당량 대비 사용량이 이 퍼센트를 넘으면 경고 처리
STORAGE_QUOTA_WARNING_THRESHOLD_PERCENT=80

# ─── 클라이언트 업로드 전 압축 가이드 파라미터 (서버 강제 아님) ────
MEDIA_COMPRESSION_IMAGE_QUALITY_PERCENT=80
MEDIA_COMPRESSION_IMAGE_MAX_WIDTH_PX=1920
MEDIA_COMPRESSION_IMAGE_MAX_HEIGHT_PX=1920

# ─── JWT ──────────────────────────────────────────────────────
# 프로덕션에서는 반드시 256비트(32바이트) 이상 랜덤 값으로 교체
JWT_SECRET=changeme-in-production-use-256bit-secret
JWT_ACCESS_EXPIRY_MS=900000       # 15분
JWT_REFRESH_EXPIRY_MS=604800000   # 7일

# ─── CORS 허용 오리진 (콤마 구분) ──────────────────────────────
# 로컬 기본값은 백엔드 코드(application.properties)에 이미 있음. 여기 값은 docker-compose로
# 띄운 backend 컨테이너(=배포/스테이징 프로파일)에 적용된다. 운영 도메인 이외에서 접근하는
# 프론트/관리자 페이지가 있으면 반드시 채워야 CORS로 막히지 않는다.
CORS_ALLOWED_ORIGINS=https://memorin.inuappcenter.co.kr

# ─── pgAdmin (tools profile 전용) ─────────────────────────────
PGADMIN_EMAIL=admin@memorin.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
