# 이 파일은 이 저장소의 docker-compose.yml로 로컬 개발 환경을 띄울 때 쓰는 예시 값이다.
# 운영 서버는 이 파일을 복사해 쓰지 않고, memorIN-deploy 저장소
# (https://github.com/inu-appcenter/memorIN-deploy)의 .env.example과 README를 따른다.

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=memorin_db
POSTGRES_USER=memorin_user
POSTGRES_PASSWORD=memorin_pass
# 호스트의 127.0.0.1에만 바인딩된다(#230) — backend와 같은 머신의 DBeaver/psql만 쓴다.
# 원격에서 직접 붙어야 하면 SSH 터널을 쓴다. 컨테이너 네트워크 안(pgAdmin 등)은 영향 없다.
POSTGRES_PORT=5432
# 실측 없이 잡은 출발점(#230). DB가 커지면 재실측 필요 — docs/hikari-pool-load-test.md 참고.
POSTGRES_MEMORY_LIMIT=512m

# ─── MinIO ────────────────────────────────────────────────────
# 로컬 전용 계정이다. S3 API 포트가 이 컴퓨터(127.0.0.1)에만 열려 있다는 전제로 둔 값이라,
# 아래 MINIO_BIND_HOST를 넓힐 때는 둘 다 기본값이 아닌 값으로 바꾼다. docker compose로 띄운
# backend는 같은 값을 MinIO 접근 키로 쓰므로 따로 바꿀 곳은 없다.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# S3 API. 클라이언트(브라우저, 앱)가 presigned URL로 직접 접근하는 포트다.
MINIO_PORT=9000
# S3 API 포트를 열 호스트 주소. 기본은 127.0.0.1이라 이 컴퓨터에서만 접근된다(#297).
# 안드로이드 에뮬레이터와 USB로 연결한 안드로이드 기기는 adb reverse tcp:9000 tcp:9000으로
# 호스트 루프백에 연결되므로 기본값으로 동작한다.
# 와이파이로만 붙는 실기기로 테스트할 때만 0.0.0.0으로 넓힌다. 그러면 같은 네트워크의 누구나 이 포트에
# 접근할 수 있으므로 위 계정을 바꾸고, 아래 MINIO_PUBLIC_ENDPOINT도 기기에서 닿는 주소로 바꾼다.
# 테스트가 끝나면 127.0.0.1로 되돌린다.
MINIO_BIND_HOST=127.0.0.1
# 관리 콘솔. 관리자 전용이라 postgres처럼 127.0.0.1에만 바인딩된다(#230).
MINIO_CONSOLE_PORT=9001
MINIO_MEMORY_LIMIT=512m
MINIO_BUCKET_NAME=memorin-media
MINIO_REGION=us-east-1
# 클라이언트(브라우저, 앱)가 presigned URL로 직접 접근할 스토리지 주소. presigned URL은 이 주소의 호스트로
# 서명되므로, 클라이언트가 실제로 요청하는 주소와 같아야 한다.
# 로컬 개발은 기본값을 쓴다. 와이파이 실기기 테스트 때만 http://<노트북 IP>:9000으로 바꾸고 끝나면 되돌린다.
# 운영 주소와 조건은 memorIN-deploy의 설정과 docs/api-spec.md 5-2절을 따른다.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# presigned URL 유효기간(초)
MINIO_PRESIGNED_UPLOAD_EXPIRY_SECONDS=600
MINIO_PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=300
# 업로드 허용 MIME 타입 (콤마 구분)
MINIO_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime
# 파일 1개 업로드 최대 크기(byte). 기본 50MB
MINIO_MAX_UPLOAD_SIZE_BYTES=52428800

# ─── Spring Boot ──────────────────────────────────────────────
BACKEND_PORT=8080
# 백엔드 컨테이너 메모리 상한. JVM 힙은 이 값의 75%로 잡힌다(JAVA_TOOL_OPTIONS).
# 채팅(WebSocket) 세션이 힙에 쌓이는 구조라 상한 없이 띄우면 환경마다 다르게 동작한다.
BACKEND_MEMORY_LIMIT=1g

SIGNUP_ENABLED=true

# ─── Storage Quota ────────────────────────────────────────────
# 유저별 총 스토리지 할당량(byte). 기본 1GB
STORAGE_QUOTA_DEFAULT_LIMIT_BYTES=1073741824
# presigned 업로드 예약(pending_uploads)의 TTL(초). 커밋 없이 만료되면 정리 배치가 회수
STORAGE_QUOTA_PENDING_TTL_SECONDS=900
# 할당량 대비 사용량이 이 퍼센트를 넘으면 경고 처리
STORAGE_QUOTA_WARNING_THRESHOLD_PERCENT=80
# 삭제된 게시물·교체된 첨부의 MinIO 오브젝트를 회수하는 배치(#259). 끄면 파일이 디스크에 계속 쌓인다.
STORAGE_MEDIA_GC_ENABLED=true
# 삭제 후 이 일수가 지나야 오브젝트를 지운다(그 사이엔 복구 여지). 지운 오브젝트는 되돌릴 수 없다.
STORAGE_MEDIA_GC_GRACE_DAYS=7
# 배치 실행 주기(ms). 기본 1시간
STORAGE_MEDIA_GC_INTERVAL_MS=3600000
# 한 주기에 처리하는 최대 개수(저사양 서버 부하 제한)
STORAGE_MEDIA_GC_BATCH_SIZE=100

# ─── 클라이언트 업로드 전 압축 가이드 파라미터 (서버 강제 아님) ────
MEDIA_COMPRESSION_IMAGE_QUALITY_PERCENT=80
MEDIA_COMPRESSION_IMAGE_MAX_WIDTH_PX=1920
MEDIA_COMPRESSION_IMAGE_MAX_HEIGHT_PX=1920

# ─── JWT ──────────────────────────────────────────────────────
# HS256 서명 키라 256비트(32바이트) 이상이어야 한다. 아래는 로컬 개발용 예시 값이고,
# 운영 값은 memorIN-deploy의 .env에서 무작위로 따로 만든다.
JWT_SECRET=changeme-in-production-use-256bit-secret
JWT_ACCESS_EXPIRY_MS=900000       # 15분
JWT_REFRESH_EXPIRY_MS=604800000   # 7일

# ─── CORS 허용 오리진 (콤마 구분) ──────────────────────────────
# docker 프로파일(이 저장소의 docker-compose.yml과 memorIN-deploy의 compose가 띄우는 backend 컨테이너)에서는 필수다.
# 기본값을 특정 조직 도메인으로 두지 않으므로, 값을 안 채우면 기동 자체가 실패한다(#229) —
# 이 저장소를 포크해서 배포할 때 남의 도메인을 조용히 물려받는 사고를 막기 위함이다.
# 로컬 기본 프로파일(dev, bootRun)은 이 값이 없어도 코드의 로컬 포트 기본값으로 동작한다.
CORS_ALLOWED_ORIGINS=https://memorin.inuappcenter.kr

# ─── Swagger / OpenAPI 문서 ────────────────────────────────────
# 켜면(true) /swagger-ui/**·/v3/api-docs가 인증 없이 열린다. 저장소가 PUBLIC이라도
# 배포 인스턴스가 전체 API 명세를 그대로 노출할지는 별개 선택이다. 기본은 꺼짐.
SWAGGER_ENABLED=false

# ─── 푸시 알림: FCM (앱 백그라운드) ────────────────────────────
# 끄면(false) 알림은 DB에 저장만 되고 발송되지 않는다. 앱 없이 웹만 쓴다면 꺼도 된다.
FIREBASE_ENABLED=false
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로 받은 JSON을
# 이 저장소의 secrets/ 폴더에 firebase-service-account.json 이름으로 둔다.
# docker-compose가 secrets/ 를 컨테이너의 /run/secrets 로 읽기 전용 마운트한다.
# (secrets/ 안의 파일은 .gitignore로 커밋이 막혀 있다.)
#
# 컨테이너는 non-root(spring)로 돌기 때문에 파일을 읽을 수 있어야 한다.
# 기동 시 "Permission denied"가 나면 호스트에서 chmod 644 secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# ─── 푸시 알림: Web Push (브라우저) ────────────────────────────
# 끄면(false) 알림은 DB에 저장만 되고 발송되지 않는다.
WEB_PUSH_ENABLED=false
# VAPID 키 쌍. 아래 중 하나로 생성한다.
#   npx web-push generate-vapid-keys
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem   (이후 base64url 인코딩 필요)
# 공개 키는 프론트엔드의 구독 등록 코드에도 같은 값이 들어가야 한다.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 발생 시 연락할 주소. mailto: 또는 https: 스킴이어야 한다.
WEB_PUSH_VAPID_SUBJECT=mailto:admin@memorin.local

# ─── pgAdmin (tools profile 전용) ─────────────────────────────
PGADMIN_EMAIL=admin@memorin.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
